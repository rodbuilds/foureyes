{
  "name": "four-eyes-monorepo",
  "private": true,
  "description": "Four Eyes (the VR web app) and Four Eyes Share (the PC companion that serves folders to a Quest).",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "apps/share"
  ],
  "scripts": {
    "test": "npm run test --workspaces",
    "test:web": "npm run test -w apps/web",
    "test:share": "npm run test -w apps/share",
    "share": "npm run start -w apps/share",
    "build:share": "npm run build -w apps/share"
  }
}
